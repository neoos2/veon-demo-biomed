---
// Final board by task: Sales / Service / E-mail / Address (UX-R-003). All numbers from client.json;
// Viber/WhatsApp buttons only where the client marks them. Telegram is not linked: links by number are not confirmed.
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { SALES, SERVICE, EMAIL, SERVICE_EMAIL, ADDRESS, MAP_URL, RFQ_MAILTO, tel, viber, whatsapp } from "../data/site";
---
<Section id="contacts" rec="UX-R-003" class="contacts" label="Контакти">
  <div class="container">
    <div class="head">
      <h2>Контакти</h2>
      <p>Оберіть, з чим звертаєтесь: продаж і підбір обладнання або сервіс.</p>
    </div>
    <div class="ct">
      <section class="ct__col ct__col--sales" aria-labelledby="ct-sales">
        <h3 id="ct-sales">Продаж</h3>
        <ul class="ct__list">
          {SALES.map((p) => (
            <li class="ct__row">
              <a class="ct__tel" href={tel(p)}><span class="num">{p.display}</span>{p.note && <span class="ct__note">{p.note}</span>}</a>
              {p.messengers && (
                <span class="ct__msg" data-rec="UX-R-002">
                  <a href={viber(p)}><Icon name="viber" size={18} /><span>Viber</span><span class="visually-hidden">{p.display}</span></a>
                  <a href={whatsapp(p)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /><span>WhatsApp</span><span class="visually-hidden">{p.display}</span></a>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
      <section class="ct__col" aria-labelledby="ct-service">
        <h3 id="ct-service">Сервіс</h3>
        <ul class="ct__list">
          {SERVICE.map((p) => (
            <li class="ct__row"><a class="ct__tel" href={tel(p)}><span class="num">{p.display}</span></a></li>
          ))}
          <li class="ct__row"><a class="ct__tel" href={`mailto:${SERVICE_EMAIL}`}><span>{SERVICE_EMAIL}</span></a></li>
        </ul>
      </section>
      <section class="ct__col" aria-labelledby="ct-mail">
        <h3 id="ct-mail">E-mail</h3>
        <ul class="ct__list">
          <li class="ct__row"><a class="ct__tel" href={`mailto:${EMAIL}`}><span>{EMAIL}</span></a></li>
          <li class="ct__row"><a class="ct__tel" href={RFQ_MAILTO}><Icon name="mail" size={18} /><span>Запит комерційної пропозиції</span></a></li>
        </ul>
        <h3 id="ct-addr" class="ct__h3-2">Адреса</h3>
        <p class="ct__addr">{ADDRESS}</p>
        <a class="btn btn--outline ct__map" href={MAP_URL} target="_blank" rel="noopener">
          <Icon name="pin" />
          <span>Відкрити на карті</span>
        </a>
      </section>
    </div>
  </div>
</Section>

<style>
  :global(.contacts) { padding-block: var(--block); }
  .ct { display: grid; gap: var(--s-6); }
  .ct__col h3 { font-size: var(--fs-21); padding-bottom: var(--s-1); border-bottom: 3px solid var(--color-brand); }
  .ct__list { display: grid; }
  .ct__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--s-2); border-bottom: 1px solid var(--color-border); padding-block: 4px; }
  .ct__tel { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 48px; color: var(--color-text); text-decoration: none; font-size: var(--fs-17); overflow-wrap: anywhere; }
  .ct__tel .num { font-size: var(--fs-21); }
  .ct__tel:hover span:first-child, .ct__tel:hover span:last-child { text-decoration: underline; }
  .ct__note { color: var(--color-text-muted); font-size: var(--fs-14); }
  .ct__msg { display: inline-flex; gap: var(--s-1); }
  .ct__msg a {
    display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 0 .75rem; border: 1.5px solid var(--color-text); border-radius: var(--radius);
    font-size: var(--fs-14); font-weight: 600; color: var(--color-text); text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .ct__msg a:hover { background: var(--color-text); color: var(--color-bg); }
  .ct__h3-2 { margin-top: var(--s-4); }
  .ct__addr { padding: var(--s-2) 0; font-size: var(--fs-17); }
  @media (min-width: 1024px) {
    .ct { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
    .ct__col--sales { grid-column: 1 / span 5; }
    .ct__col:nth-child(2) { grid-column: 6 / span 3; padding-left: var(--s-2); }
    .ct__col:nth-child(3) { grid-column: 9 / span 4; padding-left: var(--s-2); }
  }
</style>
