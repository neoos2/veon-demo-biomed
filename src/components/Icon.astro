---
// Line icons, 2 px stroke, currentColor (replaces the old site's Font Awesome, SP-R-005).
// Decorative by default: the visible label next to the icon carries the meaning.
type Name = "arrow" | "phone" | "viber" | "whatsapp" | "mail" | "pin" | "play" | "chevron" | "menu" | "close";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", `icon--${name}`, cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "arrow" && <><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></>}
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2 1.4a11 11 0 0 0 7.1 7.1l1.4-2 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5z" />}
  {name === "viber" && <><path d="M12 2.8c4.9 0 8.4 1.6 8.4 7.8s-3.5 7.8-8.4 7.8c-.7 0-1.5 0-2.2-.1L6.6 21v-3.4C4.4 16.4 3.6 14.2 3.6 10.6 3.6 4.4 7.1 2.8 12 2.8z" /><path d="M9.3 7.6c.4 2.6 2.4 4.7 5.1 5.3" /><path d="M12.6 6.4a3.4 3.4 0 0 1 3 3" /></>}
  {name === "whatsapp" && <><path d="M4 20.5 5.3 16A8.5 8.5 0 1 1 8.4 19z" /><path d="M9 8.5c0 3.3 3.2 6.5 6.5 6.5l.9-1.6-2-1-1 .9a4.6 4.6 0 0 1-2.7-2.7l.9-1-1-2z" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z" /><circle cx="12" cy="9.8" r="2.3" /></>}
  {name === "play" && <><rect x="2.5" y="5" width="19" height="14" rx="3.5" /><path d="m10 9 5 3-5 3z" /></>}
  {name === "chevron" && <path d="m9 5 7 7-7 7" />}
  {name === "menu" && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === "close" && <><path d="m6 6 12 12" /><path d="M18 6 6 18" /></>}
</svg>
